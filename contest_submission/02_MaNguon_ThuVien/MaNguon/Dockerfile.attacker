# ================================================================
# Dockerfile.attacker — Máy tấn công ICS (Kali-based)
# Build : docker build -f Dockerfile.attacker -t s7pwn-attacker .
# Run   : docker run -it --net=host --privileged s7pwn-attacker
# Script: docker run -it --net=host --privileged s7pwn-attacker \
#           bash run_attacker.sh <DAY> <TARGET_IP> <SUBNET>
# ================================================================

FROM kalilinux/kali-rolling:latest

LABEL maintainer="S7Pwn Security Research"
LABEL description="ICS Attack Machine – S7Pwn Attacker (Kali Linux)"

# ── Cài tool hệ thống cần cho kịch bản tấn công ─────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        gcc \
        libpcap-dev \
        libsnap7-dev \
        tcpdump \
        tshark \
        nmap \
        hping3 \
        dsniff \
        net-tools \
        iputils-ping \
        iproute2 \
        curl \
        wget \
        arp-scan \
    && rm -rf /var/lib/apt/lists/*

# ── Thư mục làm việc ─────────────────────────────────────────────
WORKDIR /app

# ── Cài Python dependencies (loại bỏ package chỉ dành cho Windows) ──
COPY requirements.txt .
RUN pip3 install --no-cache-dir --break-system-packages \
        python-snap7 \
        scapy \
        prompt_toolkit>=3.0.36 \
        flask>=2.3.0 \
        flask-socketio>=5.3.0 \
        flask-cors>=4.0.0 \
        pymodbus>=3.0.0 \
        requests

# ── Copy toàn bộ source code ──────────────────────────────────────
COPY s7pwn/        ./s7pwn/
COPY attacks_ext/  ./attacks_ext/
COPY setup.py      .
COPY pyproject.toml . 2>/dev/null || true

# Scripts tấn công + config
COPY run_attacker.sh            .
COPY run_day_bangtruyen.sh      . 2>/dev/null || true
COPY run_day_bangtruyen_ext.sh  . 2>/dev/null || true
COPY testbed_config.json        .
COPY label_webhook_server.py    . 2>/dev/null || true
COPY restore_plc_test.py        . 2>/dev/null || true

# ── Cài s7pwn package ─────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages -e .

# ── Tạo thư mục output ───────────────────────────────────────────
RUN mkdir -p captures logs labels tmp reports

# ── Cấp quyền thực thi cho các script ───────────────────────────
RUN chmod +x run_attacker.sh \
    && (chmod +x run_day_bangtruyen.sh 2>/dev/null || true) \
    && (chmod +x run_day_bangtruyen_ext.sh 2>/dev/null || true)

# ── Biến môi trường ──────────────────────────────────────────────
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV TARGET=192.168.1.10
ENV SUBNET=192.168.1.0/24
ENV IFACE=eth0
ENV LOGGER_URL=http://192.168.1.200:9000/label

# ── Mặc định: mở bash để người dùng chạy thủ công ───────────────
CMD ["bash"]
