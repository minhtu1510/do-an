# ================================================================
# .env.attacker — Cấu hình môi trường máy tấn công
# Đổi tên thành .env trước khi dùng với docker-compose:
#   cp .env.attacker .env
# ================================================================

# IP của PLC target
TARGET=192.168.1.10

# Subnet của testbed
SUBNET=192.168.1.0/24

# Network interface của máy attacker (dùng `ip link` để kiểm tra)
IFACE=eth0

# URL của Logger/webhook server (máy thu nhãn tấn công)
LOGGER_URL=http://192.168.1.200:9000/label
