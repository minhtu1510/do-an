# .env.example — copy thành .env rồi điền giá trị thật, KHÔNG commit .env
# lên git (đã có trong .gitignore).
#   cp .env.example .env

# Địa chỉ OPC UA server / PLC cần giám sát
OPCUA_ENDPOINT=opc.tcp://192.168.210.211:4840

# Tuỳ chọn OPC UA security. Để TRỐNG = Anonymous/No-Security (mặc định, khớp
# testbed hiện tại). Chỉ điền khi đã cấu hình server S7-1500 sang
# Basic256Sha256 + xác thực user (xem HUONG_DAN_TRIEN_KHAI_AI.md / Q2 Day7):
#   OPCUA_SECURITY=Basic256Sha256,SignAndEncrypt,client_cert.der,client_key.pem
#   OPCUA_USER=<username>
#   OPCUA_PASSWORD=<password>
OPCUA_SECURITY=
OPCUA_USER=
OPCUA_PASSWORD=

# Origin frontend được phép gọi API (cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Tuỳ chọn: đường dẫn khác tới file khai báo tag
# TAG_REGISTRY_PATH=config/opcua_tags.yaml

# Tuỳ chọn: lịch sử tag dùng SQLite mặc định (tự tạo tại web_scada/backend/data/historian.db).
# Đặt DATABASE_URL nếu muốn dùng PostgreSQL thay vì SQLite.
# DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname

# Tuỳ chọn: cảnh báo Telegram cho sự kiện mức ERROR / ATTACK_*. Để trống 1 trong 2
# biến thì tính năng này tự tắt.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bắt buộc — JWT_SECRET không có giá trị mặc định an toàn, backend sẽ từ chối
# chạy nếu để trống. Sinh 1 lần bằng:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# Tài khoản admin đầu tiên — chỉ được tạo tự động khi bảng users còn trống
# (lần chạy đầu tiên). Đổi mật khẩu sau khi cài đặt xong.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
